<UserControl x:Class="Popup.Views.Contents.ImageFillPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="560">
    <!--
    FILL 전용 이미지 View.
    공통 PopupWindow의 콘텐츠 Margin 24를 상쇄해서
    Header/Footer 사이의 본문 영역을 이미지가 빈 공간 없이 채운다.
    -->
    <Grid Margin="-24">
        <Border Background="Black"
                ClipToBounds="True">
            <Image x:Name="PopupImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Cursor="Arrow"
                   MouseLeftButtonUp="PopupImage_MouseLeftButtonUp"/>
        </Border>
    </Grid>
</UserControl>
