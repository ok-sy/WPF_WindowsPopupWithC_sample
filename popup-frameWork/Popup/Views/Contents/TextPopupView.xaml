<UserControl x:Class="Popup.Views.Contents.TextPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="320"
             MinHeight="240">

    <UserControl.Resources>

        <!--
        본문의 일반 글자 스타일

        역할
        글자 크기, 색상, 줄 간격,
        자동 줄바꿈을 통일한다.
        -->
        <Style x:Key="BodyTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="LineHeight"
                    Value="24"/>

            
        </Style>

        <!--
        제목용 TextBlock Style

        x:Key는 Style의 이름이다.
        다른 TextBlock에서
        Style="{StaticResource TitleTextStyle}"
        형태로 사용한다.
        -->
        <Style x:Key="TitleTextStyle"
       TargetType="TextBlock">

            <Setter Property="FontSize"
            Value="26"/>

            <Setter Property="FontWeight"
            Value="Bold"/>

            <Setter Property="Foreground"
            Value="#1F2937"/>

            <Setter Property="Margin"
            Value="0,0,0,8"/>
        </Style>

       
        
        <!--
        각 카드의 제목 스타일

        역할
        주요 안내와 상세 내용 제목을
        같은 디자인으로 표시한다.
        -->
        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="19"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>

        <!--
        왼쪽과 오른쪽 카드 스타일

        역할
        배경, 테두리, 둥근 모서리,
        내부 여백을 통일한다.
        -->
        <Style x:Key="CardBorderStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="20"/>

        </Style>

    </UserControl.Resources>

    <!--
    TextPopupView의 전체 본문 영역
    -->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 텍스트 팝업 전용 제목/설명 영역 -->
        <StackPanel Grid.Row="0"
                Margin="0,0,0,20">

            <TextBlock x:Name="ContentTitleText"
                        Style="{StaticResource TitleTextStyle}"
                        Text="서비스 이용 안내"/>

            <TextBlock x:Name="ContentDescriptionText"
           Style="{StaticResource BodyTextStyle}"
           Text="이 팝업은 WPF 화면 구성 예제를 보여주기 위해 만든 화면입니다."/>

        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility ="Disabled">

            <!--
            Grid를 사용해서 본문을 2개 단으로 나눈다.
            -->
            <Grid MinWidth="560">
                <Grid.ColumnDefinitions>

                    <!--
                    왼쪽 카드와 오른쪽 카드가
                    사용 가능한 공간을 같은 비율로 나눠 가진다.
                    -->
                    <ColumnDefinition Width="*"
                          MinWidth="260"/>

                    <!-- 두 단 사이 간격 -->
                    <ColumnDefinition x:Name="RightSectionSpacerColumn"
                                      Width="18"/>

                    <ColumnDefinition x:Name="RightSectionColumn"
                                      Width="*"
                          MinWidth="260"/>

                </Grid.ColumnDefinitions>

                <!--
                왼쪽 카드
                -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">

                    <StackPanel>

                        <TextBlock x:Name="LeftSectionTitleText"
                       Style="{StaticResource SectionTitleStyle}"
                       Text="1. 주요 안내"/>

                        <!--
                        Paragraph처럼 여러 줄을 표현하는
                        일반 TextBlock
                        -->
                        <TextBlock x:Name="LeftSectionBodyText"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="이 영역은 일반 텍스트를 여러 줄로 표시하는 예제입니다. TextWrapping 속성을 사용하면 창의 너비에 맞춰 자동으로 줄바꿈됩니다."/>    

                        <!--
                        Border를 사용한 강조 문구
                        -->
                        <Border x:Name="HighlightContainer"
                                Margin="0,18,0,18"
                                Padding="14"
                                Background="#EFF6FF"
                                BorderBrush="#93C5FD"
                                BorderThickness="1"
                                CornerRadius="6">

                            <TextBlock x:Name="HighlightTextBlock"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="#1D4ED8"
                                       FontWeight="SemiBold"
                                       Text="중요한 안내는 별도의 배경색과 테두리를 사용해 강조할 수 있습니다."/>

                        </Border>

                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                   Margin="0,0,0,10"
                                   Text="주요 기능"/>

                        <!--
                        ListBox

                        목록 데이터를 표시하는 컨트롤이다.

                        지금은 예제를 위해 항목을 직접 넣었다.
                        나중에는 서버 데이터와 연결할 수 있다.
                        -->
                        <ListBox BorderThickness="0"
                                 Background="Transparent"
                                 IsHitTestVisible="False">

                            <ListBoxItem Content="텍스트 자동 줄바꿈"/>

                            <ListBoxItem Content="여러 개의 문단 표시"/>

                            <ListBoxItem Content="공통 Style 사용"/>

                            <ListBoxItem Content="스크롤 가능한 본문"/>

                            <ListBoxItem Content="두 개의 단으로 화면 분리"/>

                        </ListBox>

                    </StackPanel>

                </Border>

                <!--
                오른쪽 카드
                -->
                <Border x:Name="RightSectionCard"
                        Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}">

                    <StackPanel>

                        <TextBlock x:Name="RightSectionTitleText"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="2. 상세 내용"/>

                        <!--
                        TextBlock 안의 LineBreak는
                        직접 줄을 나눌 때 사용한다.
                        -->
                        <TextBlock x:Name="RightSectionBodyText"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="첫 번째 문장입니다. 두 번째 문장입니다. LineBreak를 사용하면 원하는 위치에서 줄을 바꿀 수 있습니다."/>  

                        <!--
                        Separator

                        내용을 시각적으로 구분하는 가로선이다.
                        -->
                        <Separator Margin="0,20"/>

                        <TextBlock x:Name="AdditionalDescriptionText"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="Expander는 처음부터 모든 내용을 보여줄 필요가 없을 때 유용합니다. 도움말, 상세 설명, 주의사항 등에 자주 사용합니다."/> 

                        

                        <!--
                        Expander

                        제목을 누르면 상세 내용이 펼쳐지고
                        다시 누르면 접히는 컨트롤이다.
                        -->
                        <Expander Margin="0,22,0,0"
                                  Header="추가 설명 보기"
                                  IsExpanded="False">

                            <Border Margin="0,10,0,0"
                                    Padding="12"
                                    Background="#F9FAFB"
                                    CornerRadius="6">

                                <TextBlock Style="{StaticResource BodyTextStyle}"
                                           Text="Expander는 처음부터 모든 내용을 보여줄 필요가 없을 때 유용합니다. 도움말, 상세 설명, 주의사항 등에 자주 사용합니다."/>

                            </Border>

                        </Expander>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

        <TextBlock x:Name="BottomDescriptionText"
                   Grid.Row="2"
                   Margin="0,16,0,0"
                   Padding="14"
                   Style="{StaticResource BodyTextStyle}"
                   Background="#F9FAFB"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

    </Grid>

</UserControl>
