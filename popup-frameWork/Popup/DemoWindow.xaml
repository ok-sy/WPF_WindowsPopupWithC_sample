<Window x:Class="Popup.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Popup Demo Mode" Height="450" Width="800" ShowInTaskbar="True">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Demo Mode - 팝업 선택" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button Content="전체 팝업 순차 실행" Width="160" Height="42" Margin="0,0,0,12"
                    Click="OpenAllPopupsButton_Click"/>
            <Button Content="텍스트 팝업 열기" Width="160" Height="42" Margin="0,0,0,12"
                    Tag="TEXT" Click="OpenPopupButton_Click"/>
            <Button Content="이미지 팝업 열기" Width="160" Height="42" Margin="0,0,0,12"
                    Tag="IMAGE" Click="OpenPopupButton_Click"/>
            <Button Content="비디오 팝업 열기" Width="160" Height="42" Margin="0,0,0,12"
                    Tag="VIDEO" Click="OpenPopupButton_Click"/>
            <Button Content="설문 팝업" Width="160" Height="40" Margin="0,0,0,10"
                    Tag="SURVEY" Click="OpenPopupButton_Click"/>
            <Button Content="퀴즈 팝업" Width="160" Height="40"
                    Tag="QUIZ" Click="OpenPopupButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
