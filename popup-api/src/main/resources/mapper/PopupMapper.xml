<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    PopupMapper.java와 연결되는 SQL Mapper다.

    namespace는 Mapper 인터페이스의
    전체 패키지 경로와 정확히 같아야 한다.
-->
<mapper namespace="com.oksy.popup.mapper.PopupMapper">

    <!--
        Oracle POPUP_NOTICE 조회 결과를
        PopupEntity record 생성자에 연결한다.

        record는 setter가 없으므로
        constructor 매핑을 명시적으로 사용한다.
    -->
    <resultMap
            id="popupEntityResultMap"
            type="com.oksy.popup.domain.PopupEntity">

        <constructor>
            <idArg
                    column="POPUP_ID"
                    javaType="java.lang.String"/>

            <arg
                    column="POPUP_TYPE"
                    javaType="java.lang.String"/>

            <arg
                    column="TITLE"
                    javaType="java.lang.String"/>

            <arg
                    column="DISPLAY_START_AT"
                    javaType="java.time.OffsetDateTime"/>

            <arg
                    column="DISPLAY_END_AT"
                    javaType="java.time.OffsetDateTime"/>

            <arg
                    column="DISPLAY_MODE"
                    javaType="java.lang.String"/>

            <arg
                    column="SIZE_MODE"
                    javaType="java.lang.String"/>

            <arg
                    column="POPUP_WIDTH"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="POPUP_HEIGHT"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="WIDTH_RATIO"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="HEIGHT_RATIO"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="MINIMUM_WIDTH"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="MINIMUM_HEIGHT"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="MAXIMUM_WIDTH"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="MAXIMUM_HEIGHT"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="SHOW_HEADER_YN"
                    javaType="java.lang.String"/>

            <arg
                    column="SHOW_CLOSE_BUTTON_YN"
                    javaType="java.lang.String"/>

            <arg
                    column="SHOW_FOOTER_YN"
                    javaType="java.lang.String"/>

            <arg
                    column="SHOW_DONT_SHOW_YN"
                    javaType="java.lang.String"/>

            <arg
                    column="CONTENT_JSON"
                    javaType="java.lang.String"/>

            <arg
                    column="DISPLAY_ORDER"
                    javaType="_int"/>

            <arg
                    column="USE_YN"
                    javaType="java.lang.String"/>

            <arg
                    column="QUESTION_TEMPLATE_ID"
                    javaType="java.lang.Long"/>

            <arg
                    column="PERIOD_MODE"
                    javaType="java.lang.String"/>

            <arg
                    column="REPEAT_INTERVAL"
                    javaType="java.lang.Integer"/>

            <arg
                    column="REPEAT_DAY_OF_WEEK"
                    javaType="java.lang.String"/>

            <arg
                    column="REPEAT_DAY_OF_MONTH"
                    javaType="java.lang.Integer"/>

            <arg
                    column="HIDE_DAYS"
                    javaType="java.lang.Integer"/>

            <arg
                    column="COMPLETION_RATIO"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="PASSING_SCORE"
                    javaType="java.math.BigDecimal"/>

            <arg
                    column="ALLOW_CLOSE_BEFORE_COMPLETE_YN"
                    javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <!--
    현재 시각과 사용자 숨김 상태를 기준으로
    표시 가능한 팝업 목록을 조회한다.
-->
    <select
            id="selectAvailablePopups"
            resultMap="popupEntityResultMap">

        SELECT
        PN.POPUP_ID,
        PN.POPUP_TYPE,
        PN.TITLE,
        PN.DISPLAY_START_AT,
        PN.DISPLAY_END_AT,
        PN.DISPLAY_MODE,
        PN.SIZE_MODE,
        PN.POPUP_WIDTH,
        PN.POPUP_HEIGHT,
        PN.WIDTH_RATIO,
        PN.HEIGHT_RATIO,
        PN.MINIMUM_WIDTH,
        PN.MINIMUM_HEIGHT,
        PN.MAXIMUM_WIDTH,
        PN.MAXIMUM_HEIGHT,
        PN.SHOW_HEADER_YN,
        PN.SHOW_CLOSE_BUTTON_YN,
        PN.SHOW_FOOTER_YN,
        PN.SHOW_DONT_SHOW_YN,
        PN.CONTENT_JSON,
        PN.DISPLAY_ORDER,
        PN.USE_YN,
        CAST(NULL AS NUMBER(19)) AS QUESTION_TEMPLATE_ID,
        'FIXED' AS PERIOD_MODE,
        CAST(NULL AS NUMBER(10)) AS REPEAT_INTERVAL,
        CAST(NULL AS VARCHAR2(20)) AS REPEAT_DAY_OF_WEEK,
        CAST(NULL AS NUMBER(10)) AS REPEAT_DAY_OF_MONTH,
        CAST(NULL AS NUMBER(10)) AS HIDE_DAYS,
        CAST(NULL AS NUMBER(5,4)) AS COMPLETION_RATIO,
        CAST(NULL AS NUMBER(10,2)) AS PASSING_SCORE,
        'Y' AS ALLOW_CLOSE_BEFORE_COMPLETE_YN
        FROM POPUP_NOTICE PN
        WHERE PN.USE_YN = 'Y'

        <!--
            노출 시작 일시가 없거나
            현재 시각이 시작 일시 이후여야 한다.
        -->
        AND
        (
        PN.DISPLAY_START_AT IS NULL
        OR PN.DISPLAY_START_AT &lt;= SYSTIMESTAMP
        )

        <!--
            노출 종료 일시가 없거나
            현재 시각이 종료 일시 이전이어야 한다.
        -->
        AND
        (
        PN.DISPLAY_END_AT IS NULL
        OR PN.DISPLAY_END_AT &gt;= SYSTIMESTAMP
        )

        <!--
            현재 사용자의 유효한 숨김 정보가 존재하면
            해당 팝업을 조회 결과에서 제외한다.
        -->
        AND NOT EXISTS
        (
        SELECT
        1
        FROM USER_POPUP_STATE UPS
        WHERE UPS.USER_ID = #{userId}
        AND UPS.POPUP_ID = PN.POPUP_ID
        AND
        (
        <!--
            영구 숨김이면 만료 일시와 관계없이 제외한다.
        -->
        UPS.HIDE_TYPE = 'PERMANENT'

        OR

        <!--
            기간 숨김이면 만료 일시가
            현재보다 미래인 경우에만 제외한다.
        -->
        (
        UPS.HIDE_TYPE = 'UNTIL'
        AND UPS.HIDDEN_UNTIL &gt; SYSTIMESTAMP
        )
        )
        )

        ORDER BY
        PN.DISPLAY_ORDER,
        PN.POPUP_ID

    </select>

    <!--
    사용자별 팝업 숨김 상태를 저장한다.

    동일한 USER_ID + POPUP_ID가 존재하면 UPDATE하고,
    존재하지 않으면 INSERT한다.
-->
    <insert id="upsertPopupHide">

        MERGE INTO USER_POPUP_STATE TARGET
        USING
        (
        SELECT
        #{userId} AS USER_ID,
        #{popupId} AS POPUP_ID
        FROM DUAL
        ) SOURCE
        ON
        (
        TARGET.USER_ID = SOURCE.USER_ID
        AND TARGET.POPUP_ID = SOURCE.POPUP_ID
        )

        <!--
            기존 숨김 정보가 존재하면
            숨김 만료 일시를 현재 시각 기준으로 다시 계산한다.
        -->
        WHEN MATCHED THEN
        UPDATE SET
        TARGET.HIDE_TYPE =
        'UNTIL',

        TARGET.HIDDEN_UNTIL =
        SYSTIMESTAMP
        + NUMTODSINTERVAL(
        #{hideDays},
        'DAY'
        ),

        TARGET.UPDATED_AT =
        SYSTIMESTAMP

        <!--
            기존 숨김 정보가 없다면
            새로운 사용자 팝업 상태를 저장한다.
        -->
        WHEN NOT MATCHED THEN
        INSERT
        (
        USER_ID,
        POPUP_ID,
        HIDE_TYPE,
        HIDDEN_UNTIL,
        CREATED_AT,
        UPDATED_AT
        )
        VALUES
        (
        SOURCE.USER_ID,
        SOURCE.POPUP_ID,
        'UNTIL',

        SYSTIMESTAMP
        + NUMTODSINTERVAL(
        #{hideDays},
        'DAY'
        ),

        SYSTIMESTAMP,
        SYSTIMESTAMP
        )

    </insert>

    <!--
        MERGE 처리 후 Oracle에 저장된
        실제 숨김 만료 일시를 조회한다.
    -->
    <select
            id="selectHiddenUntil"
            resultType="java.time.OffsetDateTime">

        SELECT
        HIDDEN_UNTIL
        FROM USER_POPUP_STATE
        WHERE USER_ID = #{userId}
        AND POPUP_ID = #{popupId}

    </select>
</mapper>
