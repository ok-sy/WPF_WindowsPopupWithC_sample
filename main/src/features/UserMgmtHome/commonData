import { MetaWord } from '@local/domain'

export type SearchOption = {
  /**
   * 속성 여부
   */
  attrYn: 'Y' | 'N'

  /**
   * 엔티티 여부
   */
  entityYn: 'Y' | 'N'

  /**
   * 최대 조회 건수
   */
  maxCount: number

  /**
   * 검색 키
   */
  keyword?: string

  /**
   * 정렬키
   */
  sortKey: SearchSortKey
}

// 조회 옵션 기본값
export const DEFAULT_SEARCH_OPTION: SearchOption = {
  attrYn: 'N',
  entityYn: 'N',
  maxCount: 20,
  sortKey: {
    field: 'name',
    direction: 'asc',
  },
}

export type MetaWordDialogEvents = {
  open: {
    wordId?: number
    metaWord?: MetaWord
    onClose?: () => void
    onSaved?: (result: MetaWord) => void
    onDeleted?: (wordId: number) => void
  }
}
