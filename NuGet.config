<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    폐쇄망 빌드에서는 인터넷 NuGet 서버를 조회하지 않는다.
    prepare-offline-packages.ps1로 수집한 저장소 내부 패키지만 사용한다.
  -->
  <packageSources>
    <clear />
    <add key="repository-offline"
         value="offline-packages\nuget" />
  </packageSources>

  <!-- 패키지 캐시는 저장소 내부 임시 폴더에 만들며 Git에는 포함하지 않는다. -->
  <config>
    <add key="globalPackagesFolder"
         value=".offline-cache\packages" />
  </config>
</configuration>
