<UserControl x:Class="Popup.Views.Contents.SurveyPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="700">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <!-- 설문 제목과 설명 -->
            <RowDefinition Height="Auto"/>

            <!-- 질문 목록 -->
            <RowDefinition Height="*"/>

            <!-- 하단 제출 영역 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 설문 상단 영역 -->
        <Border Grid.Row="0"
            Padding="24,12,24,10"
            BorderBrush="#E5E7EB"
            BorderThickness="0,0,0,1">

            <StackPanel>

                <!-- 설문 제목 -->
                <TextBlock x:Name="SurveyTitleText"
                           Text="설문조사"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#111827"
                           TextWrapping="Wrap"/>

                <!-- 설문 설명 -->
                <TextBlock x:Name="SurveyDescriptionText"
                           Margin="0,6,0,0"
                           Text="아래 문항에 응답해주세요."
                           FontSize="14"
                           Foreground="#6B7280"
                           LineHeight="22"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>

        <!-- 질문 목록 영역 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!--
                코드에서 질문 UI를 만들어 이 StackPanel에 추가한다.

                Rating5       → RadioButton 5개
                SingleChoice  → RadioButton
                MultipleChoice→ CheckBox
                Text          → TextBox
            -->
            <StackPanel x:Name="QuestionListPanel"
                Margin="24,12,24,12"/>

        </ScrollViewer>

        <!-- 설문 하단 영역 -->
        <Border Grid.Row="2"
            Padding="24,10"
            BorderBrush="#E5E7EB"
            BorderThickness="0,1,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 필수 문항 안내 -->
                <TextBlock Grid.Column="0"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   Text="* 표시된 문항은 필수 응답입니다."
                   FontSize="13"
                   Foreground="#6B7280"
                   TextWrapping="Wrap"/>

                <!-- 제출 버튼 -->
                <Button x:Name="SubmitButton"
                        Grid.Column="1"
                        Width="110"
                        Height="40"
                        Padding="18,8"
                        Content="제출"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="SubmitButton_Click"/>

            </Grid>
        </Border>

    </Grid>
</UserControl>