<UserControl x:Class="Popup.Views.Contents.VideoPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Unloaded="VideoPopupView_Unloaded">

    <UserControl.Resources>
        <Style
        x:Key="VideoIconButtonStyle"
        TargetType="Button">

            <Setter
            Property="Background"
            Value="Transparent"/>

            <Setter
            Property="BorderThickness"
            Value="0"/>

            <Setter
            Property="Padding"
            Value="0"/>

            <Setter
            Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                        x:Name="ButtonBackground"
                        Background="{TemplateBinding Background}"
                        CornerRadius="18">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger
                            Property="IsMouseOver"
                            Value="True">

                                <Setter
                                TargetName="ButtonBackground"
                                Property="Background"
                                Value="#33FFFFFF"/>
                            </Trigger>

                            <Trigger
                            Property="IsPressed"
                            Value="True">

                                <Setter
                                TargetName="ButtonBackground"
                                Property="Background"
                                Value="#55FFFFFF"/>
                            </Trigger>

                            <Trigger
                            Property="IsEnabled"
                            Value="False">

                                <Setter
                                Property="Opacity"
                                Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 콘텐츠 내부 제목 -->
        <TextBlock
            x:Name="TitleTextBlock"
            Grid.Row="0"
            Margin="0,0,0,15"
            FontSize="22"
            FontWeight="Bold"
            Foreground="#111827"
            TextWrapping="Wrap"/>

        <!-- 영상 표시 영역 -->
        <Border
            x:Name="VideoContainer"
            Grid.Row="1"
            Width="720"
            Height="405"
            Background="Black"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MouseEnter="VideoContainer_MouseEnter"
            MouseLeave="VideoContainer_MouseLeave"
            MouseMove="VideoContainer_MouseMove">
            <Grid>

                <!-- 로컬 파일 또는 직접 영상 URL -->
                <MediaElement
                x:Name="PopupVideo"
                Visibility="Collapsed"
                LoadedBehavior="Manual"
                UnloadedBehavior="Manual"
                Stretch="Uniform"
                ScrubbingEnabled="True"
                MediaOpened="PopupVideo_MediaOpened"
                MediaEnded="PopupVideo_MediaEnded"
                MediaFailed="PopupVideo_MediaFailed"/>

                <!-- 웹 영상 -->
                <wv2:WebView2
                x:Name="VideoWebView"
                Visibility="Collapsed"
                NavigationCompleted="VideoWebView_NavigationCompleted"/>

                <!-- 로딩 및 오류 메시지 -->
                <Border
                x:Name="VideoMessageArea"
                Panel.ZIndex="20"
                Background="#99000000">

                    <TextBlock
                        x:Name="VideoMessageText"
                        Margin="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="영상을 불러오는 중입니다."
                        TextAlignment="Center"
                        TextWrapping="Wrap"/>
                </Border>

                <!-- 영상 위에 겹치는 하단 컨트롤바 -->
                <Border
                    x:Name="LocalVideoControlArea"
                    Panel.ZIndex="10"
                    Height="60"
                    Margin="12"
                    Padding="14,9"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="#D9111111"
                    CornerRadius="10"
                    Visibility="Collapsed"
                    MouseEnter="LocalVideoControlArea_MouseEnter"
                    MouseLeave="LocalVideoControlArea_MouseLeave">
                    

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 재생 -->
                            <ColumnDefinition Width="40"/>

                            <!-- 현재 시간 -->
                            <ColumnDefinition Width="52"/>

                            <!-- 진행바 -->
                            <ColumnDefinition Width="*"/>

                            <!-- 전체 시간 -->
                            <ColumnDefinition Width="52"/>

                            <!-- 음소거 -->
                            <ColumnDefinition Width="40"/>

                            <!-- 음량 -->
                            <ColumnDefinition Width="90"/>

                            <!-- 전체화면 -->
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- 재생 / 일시정지 -->
                        <Button
                    x:Name="PlayPauseButton"
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="PlayPauseButton_Click"
                    Style="{StaticResource VideoIconButtonStyle}"
                    ToolTip="재생">

                            <TextBlock
                        x:Name="PlayPauseIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="White"
                        Text="&#xE768;"/>
                        </Button>

                        <!-- 현재 시간 -->
                        <TextBlock
                    x:Name="CurrentTimeText"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="White"
                    Text="00:00"/>

                        <!-- 재생 진행바 -->
                        <Slider
                    x:Name="ProgressSlider"
                    Grid.Column="2"
                    Margin="6,0,10,0"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    PreviewMouseLeftButtonDown=
                        "ProgressSlider_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp=
                        "ProgressSlider_PreviewMouseLeftButtonUp"/>

                        <!-- 전체 시간 -->
                        <TextBlock
                    x:Name="DurationTimeText"
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#CCFFFFFF"
                    Text="00:00"/>

                        <!-- 음소거 -->
                        <Button
                            x:Name="MuteButton"
                            Grid.Column="4"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="MuteButton_Click"
                            Style="{StaticResource VideoIconButtonStyle}"
                            ToolTip="음소거">

                            <TextBlock
                                x:Name="VolumeIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="18"
                                Foreground="White"
                                Text="&#xE767;"/>
                        </Button>

                        <!-- 음량 -->
                        <Slider
                            x:Name="VolumeSlider"
                            Grid.Column="5"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="1"
                            Value="0.7"
                            ValueChanged="VolumeSlider_ValueChanged"/>  

                        <!-- 전체화면 -->
                        <Button
                            x:Name="FullScreenButton"
                            Grid.Column="6"
                            Width="36"
                            Height="36"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="FullScreenButton_Click"
                            Style="{StaticResource VideoIconButtonStyle}"
                            ToolTip="전체 화면">

                        <TextBlock
                            x:Name="FullScreenIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Symbol"
                            FontSize="19"
                            Foreground="White"
                            Text="⛶"/>
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Border>


        <!-- 설명 -->
        <TextBlock
        x:Name="DescriptionTextBlock"
        Grid.Row="2"
        Margin="0,15,0,0"
        FontSize="14"
        Foreground="#4B5563"
        TextWrapping="Wrap"/>

    </Grid>

</UserControl>