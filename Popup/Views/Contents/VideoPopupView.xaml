<UserControl x:Class="Popup.Views.Contents.VideoPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Unloaded="VideoPopupView_Unloaded">

    <UserControl.Resources>
        <Style
        x:Key="VideoIconButtonStyle"
        TargetType="Button">

            <Setter
            Property="Background"
            Value="Transparent"/>

            <Setter
            Property="BorderThickness"
            Value="0"/>

            <Setter
            Property="Padding"
            Value="0"/>

            <Setter
            Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                        x:Name="ButtonBackground"
                        Background="{TemplateBinding Background}"
                        CornerRadius="18">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger
                            Property="IsMouseOver"
                            Value="True">

                                <Setter
                                TargetName="ButtonBackground"
                                Property="Background"
                                Value="#33FFFFFF"/>
                            </Trigger>

                            <Trigger
                            Property="IsPressed"
                            Value="True">

                                <Setter
                                TargetName="ButtonBackground"
                                Property="Background"
                                Value="#55FFFFFF"/>
                            </Trigger>

                            <Trigger
                            Property="IsEnabled"
                            Value="False">

                                <Setter
                                Property="Opacity"
                                Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
       
        <!--
        영상 재생 진행바 스타일

        재생된 구간은
        왼쪽의 밝은 흰색에서 오른쪽의 회색으로
        부드럽게 이어지는 그라데이션으로 표시한다.

        기본 Slider의 둥근 이동 버튼은 제거하고,
        가느다란 막대만 표시한다.
        -->
        <Style x:Key="VideoProgressSliderStyle"
       TargetType="Slider">

            <!--
            실제 막대보다 클릭 가능한 영역을 넓게 유지한다.
            -->
            <Setter Property="Height"
            Value="16"/>

            <Setter Property="FocusVisualStyle"
            Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Slider">

                        <Grid VerticalAlignment="Center">

                            <!--
                            전체 진행바 배경

                            아직 재생되지 않은 구간은
                            어두운 반투명 회색으로 표시한다.
                            -->
                            <Border Height="5"
                            VerticalAlignment="Center"
                            Background="#55A0A0A0"
                            CornerRadius="2.5"/>

                            <!--
                            Slider의 현재 값에 따라
                            왼쪽 진행 영역의 너비가 자동으로 변경된다.
                            -->
                            <Track x:Name="PART_Track"
                           IsDirectionReversed="False">

                                <!--
                                현재까지 재생된 구간
                                -->
                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                Command="Slider.DecreaseLarge"
                                IsTabStop="False">

                                        <RepeatButton.Template>
                                            <ControlTemplate
                                        TargetType="RepeatButton">

                                                <Border Height="5"
                                                VerticalAlignment="Center"
                                                CornerRadius="2.5">

                                                    <Border.Background>
                                                        <LinearGradientBrush
                                                    StartPoint="0,0.5"
                                                    EndPoint="1,0.5">

                                                            <!-- 시작 부분 -->
                                                            <GradientStop
                                                        Offset="0"
                                                        Color="#FFFFFFFF"/>

                                                            <!-- 중간 부분 -->
                                                            <GradientStop
                                                        Offset="0.6"
                                                        Color="#FFE5E7EB"/>

                                                            <!-- 현재 재생 위치 부근 -->
                                                            <GradientStop
                                                        Offset="1"
                                                        Color="#FF9CA3AF"/>

                                                        </LinearGradientBrush>
                                                    </Border.Background>

                                                </Border>

                                            </ControlTemplate>
                                        </RepeatButton.Template>

                                    </RepeatButton>

                                </Track.DecreaseRepeatButton>

                                <!--
                                아직 재생되지 않은 영역은
                                위의 전체 배경 Border가 표시하므로
                                별도 색상을 사용하지 않는다.
                                -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                    Command="Slider.IncreaseLarge"
                                    IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!--
                                                아직 재생되지 않은 오른쪽 영역

                                                기본 상태는 기존 회색바와 비슷하게,
                                                hover 상태에서는 아주 조금만 밝아진다.
                                                -->
                                                <Border
                                                x:Name="RemainingTrack"
                                                Height="5"
                                                VerticalAlignment="Center"
                                                Background="#55A0A0A0"
                                                CornerRadius="2.5"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger
                                                    Property="IsMouseOver"
                                                    Value="True">
                                                        <Setter
                                                        TargetName="RemainingTrack"
                                                        Property="Background"
                                                        Value="#779A9A9A"/>

                                                    </Trigger>
                                                    <Trigger
                                                    Property="IsPressed"
                                                    Value="True">
                                                        <Setter
                                                        TargetName="RemainingTrack"
                                                        Property="Background"
                                                        Value="#888F8F8F"/>
                                                    </Trigger> 
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <!--둥근 Thumb를 제거한다.
                                크기가 0인 투명 Thumb를 사용하면
                                Slider의 내부 구조와 드래그 동작은 유지하면서
                                화면에는 도형이 보이지 않는다.
                                -->
                                <Track.Thumb>
                                    <Thumb Width="0"
                                           Height="0"
                                           Background="Transparent"
                                           BorderThickness="0"/>

                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>
        <!--
        영상 음량 Slider 스타일

        현재 음량 구간은
        밝은 흰색에서 회색으로 이어지는
        그라데이션 막대로 표시한다.

        동그란 Thumb는 화면에서 제거한다.
        -->
        <Style x:Key="VideoVolumeSliderStyle"
       TargetType="Slider">

            <Setter Property="Height"
            Value="16"/>

            <Setter Property="FocusVisualStyle"
            Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Slider">

                        <Grid VerticalAlignment="Center">

                            <!-- 전체 음량 바 배경 -->
                            <Border Height="5"
                            VerticalAlignment="Center"
                            Background="#55777777"
                            CornerRadius="2.5"/>

                            <Track x:Name="PART_Track"
                           IsDirectionReversed="False">

                                <!-- 현재 음량 구간 -->
                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                Command="Slider.DecreaseLarge"
                                IsTabStop="False">

                                        <RepeatButton.Template>
                                            <ControlTemplate
                                        TargetType="RepeatButton">

                                                <Border Height="5"
                                                VerticalAlignment="Center"
                                                CornerRadius="2.5">

                                                    <Border.Background>
                                                        <LinearGradientBrush
                                                    StartPoint="0,0.5"
                                                    EndPoint="1,0.5">

                                                            <GradientStop
                                                        Offset="0"
                                                        Color="#FFFFFFFF"/>

                                                            <GradientStop
                                                        Offset="0.65"
                                                        Color="#FFE5E7EB"/>

                                                            <GradientStop
                                                        Offset="1"
                                                        Color="#FF9CA3AF"/>

                                                        </LinearGradientBrush>
                                                    </Border.Background>

                                                </Border>

                                            </ControlTemplate>
                                        </RepeatButton.Template>

                                    </RepeatButton>

                                </Track.DecreaseRepeatButton>

                                <!-- 남은 음량 영역 -->
                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                Command="Slider.IncreaseLarge"
                                IsTabStop="False">

                                        <RepeatButton.Template>
                                            <ControlTemplate
                                        TargetType="RepeatButton">

                                                <Border
                                            x:Name="RemainingVolumeTrack"
                                            Height="5"
                                            VerticalAlignment="Center"
                                            Background="#55777777"
                                            CornerRadius="2.5"/>

                                                <ControlTemplate.Triggers>

                                                    <Trigger
                                                Property="IsMouseOver"
                                                Value="True">

                                                        <Setter
                                                    TargetName="RemainingVolumeTrack"
                                                    Property="Background"
                                                    Value="#777F7F7F"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </RepeatButton.Template>

                                    </RepeatButton>

                                </Track.IncreaseRepeatButton>

                                <!-- Thumb는 보이지 않게 처리 -->
                                <Track.Thumb>

                                    <Thumb Width="0"
                                   Height="0"
                                   Background="Transparent"
                                   BorderThickness="0"/>

                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 콘텐츠 내부 제목 -->
        <TextBlock
            x:Name="TitleTextBlock"
            Grid.Row="0"
            Margin="0,0,0,15"
            FontSize="22"
            FontWeight="Bold"
            Foreground="#111827"
            TextWrapping="Wrap"/>

        <!-- 영상 표시 영역 -->
        <Border
            x:Name="VideoContainer"
            Grid.Row="1"
            Background="Black"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            MouseEnter="VideoContainer_MouseEnter"
            MouseLeave="VideoContainer_MouseLeave"
            MouseMove="VideoContainer_MouseMove">
            <Grid>

                <!-- 로컬 파일 또는 직접 영상 URL -->
                <MediaElement
                x:Name="PopupVideo"
                Visibility="Collapsed"
                LoadedBehavior="Manual"
                UnloadedBehavior="Manual"
                Stretch="Uniform"
                ScrubbingEnabled="True"
                MediaOpened="PopupVideo_MediaOpened"
                MediaEnded="PopupVideo_MediaEnded"
                MediaFailed="PopupVideo_MediaFailed"/>

                <!-- 웹 영상 -->
                <wv2:WebView2
                x:Name="VideoWebView"
                Visibility="Collapsed"
                NavigationCompleted="VideoWebView_NavigationCompleted"/>

                <!-- 로딩 및 오류 메시지 -->
                <Border
                x:Name="VideoMessageArea"
                Panel.ZIndex="20"
                Background="#99000000">

                    <TextBlock
                        x:Name="VideoMessageText"
                        Margin="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="영상을 불러오는 중입니다."
                        TextAlignment="Center"
                        TextWrapping="Wrap"/>
                </Border>

                <!-- 영상 위에 겹치는 하단 컨트롤바 -->
                <Border
                    x:Name="LocalVideoControlArea"
                    Panel.ZIndex="10"
                    Height="60"
                    Margin="12"
                    Padding="14,9"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="#D9111111"
                    CornerRadius="10"
                    Visibility="Collapsed"
                    MouseEnter="LocalVideoControlArea_MouseEnter"
                    MouseLeave="LocalVideoControlArea_MouseLeave">
                    

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 재생 -->
                            <ColumnDefinition Width="40"/>

                            <!-- 현재 시간 -->
                            <ColumnDefinition Width="52"/>

                            <!-- 진행바 -->
                            <ColumnDefinition Width="*"/>

                            <!-- 전체 시간 -->
                            <ColumnDefinition Width="52"/>

                            <!-- 음소거 -->
                            <ColumnDefinition Width="40"/>

                            <!-- 음량 -->
                            <ColumnDefinition Width="90"/>

                            <!-- 전체화면 -->
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- 재생 / 일시정지 -->
                        <Button
                    x:Name="PlayPauseButton"
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="PlayPauseButton_Click"
                    Style="{StaticResource VideoIconButtonStyle}"
                    ToolTip="재생">

                            <TextBlock
                        x:Name="PlayPauseIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="White"
                        Text="&#xE768;"/>
                        </Button>

                        <!-- 현재 시간 -->
                        <TextBlock
                    x:Name="CurrentTimeText"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="White"
                    Text="00:00"/>

                        
                        <!--
                        영상 재생 위치 진행바

                        왼쪽의 재생 완료 구간은
                        VideoProgressSliderStyle의 그라데이션으로 표시한다.
                        -->
                        <Slider
                        x:Name="ProgressSlider"
                        Grid.Column="2"
                        Margin="6,0,10,0"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        Style="{StaticResource VideoProgressSliderStyle}"
                        PreviewMouseLeftButtonDown=
                            "ProgressSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseMove=
                            "ProgressSlider_PreviewMouseMove"
                        PreviewMouseLeftButtonUp=
                            "ProgressSlider_PreviewMouseLeftButtonUp"/>     

                        <!-- 전체 시간 -->
                        <TextBlock
                    x:Name="DurationTimeText"
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#CCFFFFFF"
                    Text="00:00"/>

                        <!-- 음소거 -->
                        <Button
                            x:Name="MuteButton"
                            Grid.Column="4"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="MuteButton_Click"
                            Style="{StaticResource VideoIconButtonStyle}"
                            ToolTip="음소거">

                            <TextBlock
                                x:Name="VolumeIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="18"
                                Foreground="White"
                                Text="&#xE767;"/>
                        </Button>

                        <!-- 음량 -->
                        <Slider
                        x:Name="VolumeSlider"
                        Grid.Column="5"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="1"
                        Value="0.7"
                        Style="{StaticResource VideoVolumeSliderStyle}"
                        PreviewMouseLeftButtonDown=
                            "VolumeSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseMove=
                            "VolumeSlider_PreviewMouseMove"
                        PreviewMouseLeftButtonUp=
                            "VolumeSlider_PreviewMouseLeftButtonUp"
                        ValueChanged=
                            "VolumeSlider_ValueChanged"/>

                        <!-- 전체화면 -->
                        <Button
                            x:Name="FullScreenButton"
                            Grid.Column="6"
                            Width="36"
                            Height="36"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="FullScreenButton_Click"
                            Style="{StaticResource VideoIconButtonStyle}"
                            ToolTip="전체 화면">

                        <TextBlock
                            x:Name="FullScreenIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Symbol"
                            FontSize="19"
                            Foreground="White"
                            Text="⛶"/>
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Border>


        <!-- 설명 -->
        <TextBlock
        x:Name="DescriptionTextBlock"
        Grid.Row="2"
        Margin="0,15,0,0"
        FontSize="14"
        Foreground="#4B5563"
        TextWrapping="Wrap"/>

    </Grid>

</UserControl>