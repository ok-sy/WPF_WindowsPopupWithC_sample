<Window x:Class="Popup.TextPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextPopupWindow"
        Width="760"
        Height="620"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        
        
        >
        
    <!--
    Window.Resources

    이 창 안에서 반복해서 사용할 Style과 색상 등을 모아두는 영역이다.

    HTML과 비교하면
    style 태그나 CSS 클래스 모음과 비슷하다.
    -->
    <Window.Resources>

        <!--
        제목용 TextBlock Style

        x:Key는 Style의 이름이다.
        다른 TextBlock에서
        Style="{StaticResource TitleTextStyle}"
        형태로 사용한다.
        -->
        <Style x:Key="TitleTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="26"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>
        </Style>

        <!--
        소제목용 TextBlock Style
        -->
        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#2563EB"/>

            <Setter Property="Margin"
                    Value="0,0,0,12"/>
        </Style>

        <!--
        본문용 TextBlock Style

        TextWrapping을 Wrap으로 설정해서
        글이 길면 자동으로 다음 줄로 내려가게 한다.
        -->
        <Style x:Key="BodyTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="LineHeight"
                    Value="25"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="Foreground"
                    Value="#374151"/>
        </Style>

        <!--
PopupButtonStyle

목적
팝업에서 사용하는 닫기 버튼의 모양을 공통으로 정의한다.

왜 직접 만드는가
기본 WPF 버튼 모양 대신
둥근 모서리와 마우스 오버 효과를 적용하기 위해서다.
-->
        <Style x:Key="PopupButtonStyle"
       TargetType="Button">

            <!-- 버튼 너비 -->
            <Setter Property="Width"
            Value="110"/>

            <!-- 버튼 높이 -->
            <Setter Property="Height"
            Value="38"/>

            <!-- 버튼 글자 크기 -->
            <Setter Property="FontSize"
            Value="14"/>

            <!-- 버튼 글자 굵기 -->
            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <!-- 버튼 위에 마우스를 올리면 손가락 모양 표시 -->
            <Setter Property="Cursor"
            Value="Hand"/>

            <!-- 버튼 기본 배경색 -->
            <Setter Property="Background"
            Value="#6B7280"/>

            <!-- 버튼 글자색 -->
            <Setter Property="Foreground"
            Value="White"/>

            <!-- 기본 테두리는 사용하지 않음 -->
            <Setter Property="BorderThickness"
            Value="0"/>

            <!--
    Template

    Button의 실제 생김새를 직접 정의한다.

    기본 WPF 버튼 템플릿을 사용하지 않고
    Border와 ContentPresenter로 새 버튼을 만든다.
    -->
            <Setter Property="Template">

                <Setter.Value>

                    <!--
            ControlTemplate

            Button 타입을 위한 화면 틀이다.
            -->
                    <ControlTemplate TargetType="Button">

                        <!--
                Border

                버튼의 배경, 둥근 모서리,
                안쪽 여백을 담당한다.
                -->
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        Padding="16,6">

                            <!--
                    ContentPresenter

                    Button의 Content 값을 화면에 출력한다.

                    현재 버튼에서는
                    Content="닫기"가 여기에 표시된다.
                    -->
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                        <!--
                ControlTemplate.Triggers

                버튼 상태에 따라 모양을 바꾸는 영역이다.
                -->
                        <ControlTemplate.Triggers>

                            <!--
                    마우스를 버튼 위에 올렸을 때
                    -->
                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#4B5563"/>

                            </Trigger>

                            <!--
                    버튼을 누르고 있는 동안
                    -->
                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#374151"/>

                            </Trigger>

                            <!--
                    버튼을 사용할 수 없는 상태
                    -->
                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#D1D5DB"/>

                                <Setter Property="Foreground"
                                Value="#9CA3AF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!--
        각 본문 단을 감싸는 카드 Style
        -->
        <Style x:Key="CardBorderStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="20"/>
        </Style>

    </Window.Resources>

    <!--
    Grid

    팝업 전체 화면을 세로 3개 구역으로 나눈다.

    첫 번째 행
    제목 영역

    두 번째 행
    스크롤되는 본문 영역

    세 번째 행
    체크박스와 버튼 영역
    -->
    <Border Margin="24"
        Background="White"
        BorderBrush="#D1D5DB"
        BorderThickness="1"
        CornerRadius="12"
        Padding="24">

        <!--
    Grid

    팝업 내부를 제목, 본문, 하단 버튼 영역으로 나눈다.
    -->
        <Grid>

            <Grid.RowDefinitions>

                <!-- 제목 영역은 내용 크기만큼 사용 -->
            <RowDefinition Height="Auto"/>

            <!-- 본문 영역은 남은 공간을 모두 사용 -->
            <RowDefinition Height="*"/>

            <!-- 하단 영역은 내용 크기만큼 사용 -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!--
        제목 영역
        -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <!-- 공통 제목 Style 적용 -->
            <TextBlock Style="{StaticResource TitleTextStyle}"
                       Text="서비스 이용 안내"/>

            <!--
            여러 Run을 사용하면
            한 TextBlock 안에서 글자별로 Style을 다르게 줄 수 있다.
            -->
            <TextBlock Style="{StaticResource BodyTextStyle}">

                <Run Text="이 팝업은 "/>

                <Run Text="WPF 화면 구성 예제"
                     FontWeight="Bold"
                     Foreground="#DC2626"/>

                <Run Text="를 보여주기 위해 만든 화면입니다."/>

            </TextBlock>

        </StackPanel>

        <!--
        ScrollViewer

        본문 내용이 창보다 길어질 때
        세로 스크롤바를 만들어준다.
        -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!--
            Grid를 사용해서 본문을 2개 단으로 나눈다.
            -->
            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- 왼쪽 단 -->
                    <ColumnDefinition Width="*"/>

                    <!-- 두 단 사이 간격 -->
                    <ColumnDefinition Width="18"/>

                    <!-- 오른쪽 단 -->
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!--
                왼쪽 카드
                -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">

                    <StackPanel>

                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="1. 주요 안내"/>

                        <!--
                        Paragraph처럼 여러 줄을 표현하는 일반 TextBlock
                        -->
                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                   Text="이 영역은 일반 텍스트를 여러 줄로 표시하는 예제입니다. TextWrapping 속성을 사용하면 창의 너비에 맞춰 자동으로 줄바꿈됩니다."/>

                        <!--
                        Border를 사용한 강조 문구
                        -->
                        <Border Margin="0,18,0,18"
                                Padding="14"
                                Background="#EFF6FF"
                                BorderBrush="#93C5FD"
                                BorderThickness="1"
                                CornerRadius="6">

                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                       Foreground="#1D4ED8"
                                       FontWeight="SemiBold"
                                       Text="중요한 안내는 별도의 배경색과 테두리를 사용해 강조할 수 있습니다."/>

                        </Border>

                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                   Margin="0,0,0,10"
                                   Text="주요 기능"/>

                        <!--
                        ListBox

                        목록 데이터를 표시하는 컨트롤이다.

                        지금은 예제를 위해 항목을 직접 넣었다.
                        나중에는 서버 데이터와 연결할 수 있다.
                        -->
                        <ListBox BorderThickness="0"
                                 Background="Transparent"
                                 IsHitTestVisible="False">

                            <ListBoxItem Content="텍스트 자동 줄바꿈"/>

                            <ListBoxItem Content="여러 개의 문단 표시"/>

                            <ListBoxItem Content="공통 Style 사용"/>

                            <ListBoxItem Content="스크롤 가능한 본문"/>

                            <ListBoxItem Content="두 개의 단으로 화면 분리"/>

                        </ListBox>

                    </StackPanel>

                </Border>

                <!--
                오른쪽 카드
                -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}">

                    <StackPanel>

                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="2. 상세 내용"/>

                        <!--
                        TextBlock 안의 LineBreak는
                        직접 줄을 나눌 때 사용한다.
                        -->
                        <TextBlock Style="{StaticResource BodyTextStyle}">

                            <Run Text="첫 번째 문장입니다."/>

                            <LineBreak/>

                            <Run Text="두 번째 문장입니다."/>

                            <LineBreak/>

                            <Run Text="LineBreak를 사용하면 원하는 위치에서 줄을 바꿀 수 있습니다."/>

                        </TextBlock>

                        <!--
                        Separator

                        내용을 시각적으로 구분하는 가로선이다.
                        -->
                        <Separator Margin="0,20"/>

                        <TextBlock Style="{StaticResource BodyTextStyle}">

                            <Run Text="현재 상태: "
                                 FontWeight="Bold"/>

                            <Run Text="정상"
                                 Foreground="#16A34A"
                                 FontWeight="Bold"/>

                        </TextBlock>

                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                   Margin="0,12,0,0">

                            <Run Text="공지 기간: "
                                 FontWeight="Bold"/>

                            <Run Text="2026년 7월 15일부터 2026년 8월 15일까지"/>

                        </TextBlock>

                        <!--
                        Expander

                        제목을 누르면 상세 내용이 펼쳐지고
                        다시 누르면 접히는 컨트롤이다.
                        -->
                        <Expander Margin="0,22,0,0"
                                  Header="추가 설명 보기"
                                  IsExpanded="False">

                            <Border Margin="0,10,0,0"
                                    Padding="12"
                                    Background="#F9FAFB"
                                    CornerRadius="6">

                                <TextBlock Style="{StaticResource BodyTextStyle}"
                                           Text="Expander는 처음부터 모든 내용을 보여줄 필요가 없을 때 유용합니다. 도움말, 상세 설명, 주의사항 등에 자주 사용합니다."/>

                            </Border>

                        </Expander>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

        <!--
        하단 영역

        체크박스는 왼쪽
        닫기 버튼은 오른쪽에 배치한다.
        -->
        <Grid Grid.Row="2"
              Margin="0,20,0,0">

            <Grid.ColumnDefinitions>

                <!-- 왼쪽 영역 -->
                <ColumnDefinition Width="*"/>

                <!-- 오른쪽 버튼 영역 -->
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <!--
            CheckBox

            사용자가 선택하거나 선택 해제할 수 있는 입력 컨트롤이다.
            -->
            <CheckBox x:Name="DoNotShowAgainCheckBox"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      FontSize="14"
                      Content="30일간 보지 않기"/>

            <!--
            Button

            Click 속성은
            C# 파일의 CloseButton_Click 메서드와 연결된다.
            -->
            <Button Grid.Column="1"
                    Style="{StaticResource PopupButtonStyle}"
                    Content="닫기"
                    Click="CloseButton_Click"/>

            </Grid>
    
        </Grid>
        
    </Border>
</Window>