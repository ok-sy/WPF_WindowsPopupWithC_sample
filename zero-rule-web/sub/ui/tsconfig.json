{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "strictNullChecks": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": false,
    "noImplicitAny": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
