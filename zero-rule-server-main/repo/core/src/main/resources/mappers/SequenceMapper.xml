<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="server.repo.core.mapper.SequenceMapper">

    <select id="nextAuthSeq" resultType="long">
        SELECT nextval('auth_seq')
    </select>

    <select id="nextFileSeq" resultType="long">
        SELECT nextval('file_seq')
    </select>

    <select id="nextAccountSeq" resultType="long">
        SELECT nextval('account_seq')
    </select>

    <select id="nextCommonSeq" resultType="long">
        SELECT nextval('common_seq')
    </select>

</mapper>