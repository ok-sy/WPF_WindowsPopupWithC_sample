<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="server.repo.core.mapper.MessageMapper">

    <!-- 메시지 목록 조회 -->
    <select id="findMsgList" resultType="server.domain.vo.CLMsgVo">
        SELECT MSG_ID
             , MSG_CLSF
             , TSK_CLSF_CD
             , TEAM_ID
             , OCCR_CLSF_CD
             , MSG_PRNT_CD
             , MSG_CN
             , USE_YN
          FROM CLOVER_MSG_MNG
         WHERE USE_YN = 'Y'
         ORDER BY MSG_ID
    </select>
</mapper>
