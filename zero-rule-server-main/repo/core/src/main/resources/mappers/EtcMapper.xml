<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="server.repo.core.mapper.EtcMapper">


    <!-- 로그인 실패건 삭제-->
    <delete id="deleteOldLoginFailByMaxRegDttmBefore" parameterType="java.time.Instant">
        <![CDATA[
            DELETE
              FROM CLOVER_USER_LGON_FAIL
             WHERE REG_DTTM <= #{value}
        ]]>
    </delete>

</mapper>
