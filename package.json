{
  "name": "zero-rule-web",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "main",
    "sub/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "lint-fix": "turbo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.2"
}
